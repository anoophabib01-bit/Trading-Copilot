//@version=6
// =============================================================================
// Anoop — Key Levels + One Alert  (MNQ1! / MGC1! / any instrument)
// =============================================================================
// Plots the SAME six fixed levels the MNQ Co-Pilot app draws in its London prep
// ritual, and raises ONE alert whenever price closes across any of them.
//
// WHY THIS EXISTS
//   TradingView has no API to create price alerts programmatically (confirmed
//   2026-07-31 — the whole DOM/CDP path is unreliable and a wrong alert is
//   worse than no alert). Pine's alert() is TradingView's supported path and
//   does not break on UI updates. Set it ONCE per chart, forever.
//
// LEVELS (mirrors server.js getPDHPDL / getPrevWeekHighLow / getAsiaHighLow)
//   PDH / PDL              previous DAILY bar high/low
//   Prev Week High / Low   previous WEEKLY bar high/low
//   Asia High / Low        05:30–13:30 IST window (Tokyo open → London open)
//
// Current Week/Month H/L are deliberately EXCLUDED: they self-update, so a
// cross alert on them fires continuously during any trend. Ask before adding.
//
// SETUP (do once per chart, on BOTH MNQ1! and MGC1!)
//   1. Add this indicator to the chart.
//   2. Right-click chart → Add alert.
//   3. Condition: this indicator → "Any alert() function call".
//   4. Set expiry as far out as your plan allows. Create.
//   That's it — no daily setup. Levels recalculate themselves each day/week.
// =============================================================================

indicator("Anoop Key Levels + Alert", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ── Inputs ───────────────────────────────────────────────────────────────────
grpL      = "Levels"
showPD    = input.bool(true,  "Previous Day High/Low (PDH/PDL)", group = grpL)
showPW    = input.bool(true,  "Previous Week High/Low",           group = grpL)
showAsia  = input.bool(true,  "Asia Session High/Low",            group = grpL)

grpA      = "Alerts"
alertOn   = input.bool(true,  "Enable alerts", group = grpA,
     tooltip = "Fires once per bar close when price closes across any enabled level.")
sessOnly  = input.bool(false, "Only alert during London + NY windows", group = grpA,
     tooltip = "London 13:30-15:00 IST, NY 19:00-21:00 IST. Off = alert any time.")

grpS      = "Asia session"
asiaSess  = input.session("0530-1330", "Asia window (IST)", group = grpS,
     tooltip = "Tokyo open to London open, matching the Co-Pilot app.")

grpV      = "Style"
showLbls  = input.bool(true, "Show level labels", group = grpV)

TZ = "Asia/Kolkata"

// ── Previous day / previous week ─────────────────────────────────────────────
// lookahead_on with the [1] offset is the standard, non-repainting way to read
// a COMPLETED higher-timeframe bar (the value is already final, so there is no
// future leak).
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)

// ── Asia session high/low ────────────────────────────────────────────────────
inAsia    = not na(time(timeframe.period, asiaSess, TZ))
asiaStart = inAsia and not inAsia[1]

var float asiaHiRun = na
var float asiaLoRun = na
var float asiaHi    = na
var float asiaLo    = na

if asiaStart
    asiaHiRun := high
    asiaLoRun := low
else if inAsia
    asiaHiRun := math.max(nz(asiaHiRun, high), high)
    asiaLoRun := math.min(nz(asiaLoRun, low),  low)

// Publish the range once the session closes, and keep it live while inside it
// so the levels are usable during the Asia window too.
if inAsia
    asiaHi := asiaHiRun
    asiaLo := asiaLoRun
else if not inAsia and inAsia[1]
    asiaHi := asiaHiRun
    asiaLo := asiaLoRun

// ── Plots ────────────────────────────────────────────────────────────────────
// Colours match the app's drawLevelLine() calls in server.js.
cPD_H = color.new(#d1293b, 0)
cPD_L = color.new(#16883f, 0)
cPW   = color.new(#7a4fc9, 0)
cASIA = color.new(#b5750a, 0)

pPdh = plot(showPD   ? pdh    : na, "PDH",            color = cPD_H, style = plot.style_linebr, linewidth = 1)
pPdl = plot(showPD   ? pdl    : na, "PDL",            color = cPD_L, style = plot.style_linebr, linewidth = 1)
pPwh = plot(showPW   ? pwh    : na, "Prev Week High", color = cPW,   style = plot.style_linebr, linewidth = 1)
pPwl = plot(showPW   ? pwl    : na, "Prev Week Low",  color = cPW,   style = plot.style_linebr, linewidth = 1)
pAsH = plot(showAsia ? asiaHi : na, "Asia High",      color = cASIA, style = plot.style_linebr, linewidth = 1)
pAsL = plot(showAsia ? asiaLo : na, "Asia Low",       color = cASIA, style = plot.style_linebr, linewidth = 1)

// ── Labels (right edge, last bar only — no clutter, no label spam) ───────────
mkLabel(show, lvl, txt, col) =>
    var label lb = na
    if show and barstate.islast and not na(lvl)
        label.delete(lb)
        lb := label.new(bar_index + 6, lvl, txt + "  " + str.tostring(lvl, format.mintick),
             xloc = xloc.bar_index, style = label.style_label_left,
             color = color.new(col, 85), textcolor = col, size = size.small)
    lb

if showLbls
    mkLabel(showPD,   pdh,    "PDH",       cPD_H)
    mkLabel(showPD,   pdl,    "PDL",       cPD_L)
    mkLabel(showPW,   pwh,    "PW High",   cPW)
    mkLabel(showPW,   pwl,    "PW Low",    cPW)
    mkLabel(showAsia, asiaHi, "Asia High", cASIA)
    mkLabel(showAsia, asiaLo, "Asia Low",  cASIA)

// ── Session gate (optional) ──────────────────────────────────────────────────
// London 13:30-15:00 IST and NY 19:00-21:00 IST, per CLAUDE.md rule #6.
inLondon = not na(time(timeframe.period, "1330-1500", TZ))
inNY     = not na(time(timeframe.period, "1900-2100", TZ))
gateOk   = not sessOnly or inLondon or inNY

// ── Cross detection ──────────────────────────────────────────────────────────
// ta.cross(close, lvl) fires only when the close moves from one side of the
// level to the other — it does NOT fire repeatedly while price hovers.
crossed(on, lvl) =>
    on and not na(lvl) and ta.cross(close, lvl)

xPdh  = crossed(showPD,   pdh)
xPdl  = crossed(showPD,   pdl)
xPwh  = crossed(showPW,   pwh)
xPwl  = crossed(showPW,   pwl)
xAsH  = crossed(showAsia, asiaHi)
xAsL  = crossed(showAsia, asiaLo)

anyX = xPdh or xPdl or xPwh or xPwl or xAsH or xAsL

// Build a message naming the level(s) actually hit.
hitName = ""
hitName := xPdh ? "PDH "       + str.tostring(pdh,    format.mintick) : hitName
hitName := xPdl ? "PDL "       + str.tostring(pdl,    format.mintick) : hitName
hitName := xPwh ? "PW High "   + str.tostring(pwh,    format.mintick) : hitName
hitName := xPwl ? "PW Low "    + str.tostring(pwl,    format.mintick) : hitName
hitName := xAsH ? "Asia High " + str.tostring(asiaHi, format.mintick) : hitName
hitName := xAsL ? "Asia Low "  + str.tostring(asiaLo, format.mintick) : hitName

if alertOn and gateOk and anyX
    alert(syminfo.ticker + " " + timeframe.period + " — crossed " + hitName +
         "  |  price " + str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)

// Visual confirmation on the chart when a cross fires.
plotshape(anyX and gateOk, "Level cross", shape.xcross, location.absolute,
     color = color.new(color.orange, 0), size = size.tiny)
