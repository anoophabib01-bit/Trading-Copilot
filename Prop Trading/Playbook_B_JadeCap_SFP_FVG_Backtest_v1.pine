//@version=5
strategy("Playbook B - JadeCap SFP+FVG | Anoop",
     overlay            = true,
     initial_capital    = 50000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 1.0,
     slippage           = 2,
     calc_on_every_tick = false,
     max_bars_back      = 500)

// ============================================================
// PLAYBOOK B -- best-effort codification of JadeCap 3-Step (SFP+FVG).
// Read before trusting results:
//  - "Equal highs/lows" and "neutral/range day" are subjective in the
//    original playbook. This approximates "trending" with ADX and does
//    NOT explicitly detect equal-liquidity pools -- it only reacts to
//    the single most recent rolling swing high/low.
//  - HTF bias here = Daily EMA200 direction, a proxy for "Daily/Weekly/
//    4H trend" -- not literal multi-timeframe structure reading.
//  - This is a looser approximation than Playbook A+C. Treat results
//    as directional, not a verdict on the discretionary version.
//  - Run this on the 1H chart (MNQ1!). Alerts fire via TradingView's
//    strategy order-fill alerts (Create Alert -> this strategy), not
//    alertcondition -- that call has no effect inside a strategy script.
//  - Compiled clean on TradingView (v5, only a "v6 recommended" notice,
//    no blocking errors) as of 2026-07-04.
// ============================================================

var GRP1 = "Bias / Filter"
adx_len = input.int(14, "ADX length (trend filter)", group=GRP1)
adx_min = input.float(20.0, "Min ADX to allow signal (skip range days)", group=GRP1)

var GRP2 = "SFP / FVG"
piv_left    = input.int(5, "Swing lookback bars (for SFP level)", minval=2, maxval=20, group=GRP2)
fvg_min_pts = input.float(2.0, "Min FVG size (pts)", minval=0.0, maxval=50.0, group=GRP2)
max_setup_age = input.int(3, "Max bars between SFP and FVG (displacement window)", minval=1, maxval=10, group=GRP2)
max_zone_age  = input.int(10, "Max bars a pending FVG zone stays valid for retrace entry", minval=1, maxval=30, group=GRP2)

var GRP3 = "Risk"
rr_ratio      = input.float(2.0, "Target R:R", minval=1.0, maxval=5.0, step=0.5, group=GRP3)
sl_buffer     = input.float(3.0, "SL buffer beyond SFP wick (pts)", minval=0.0, maxval=20.0, step=0.5, group=GRP3)
max_contracts = input.int(1, "Contracts (MNQ micros)", minval=1, maxval=40, group=GRP3)

// ─── DAILY BIAS PROXY ─────────────────────────────────────────
ema200D   = request.security(syminfo.tickerid, "D", ta.ema(close, 200), lookahead=barmerge.lookahead_off)
bull_bias = close > ema200D
bear_bias = close < ema200D

// ─── TREND FILTER (proxy for "avoid neutral/range day") ───────
[diplus, diminus, adx] = ta.dmi(adx_len, adx_len)
trending = adx >= adx_min

// ─── RECENT SWING LEVEL (liquidity level for the SFP) ─────────
swingHigh = ta.highest(high, piv_left)[1]
swingLow  = ta.lowest(low, piv_left)[1]

// ─── SFP DETECTION ──────────────────────────────────────────────
bear_sfp = high > swingHigh and close < swingHigh   // sweep of buy-side liquidity, close back inside
bull_sfp = low  < swingLow  and close > swingLow    // sweep of sell-side liquidity, close back inside

// ─── FVG DETECTION (3-candle) ────────────────────────────────────
bull_fvg = low > high[2] and (low - high[2]) >= fvg_min_pts
bear_fvg = high < low[2] and (low[2] - high) >= fvg_min_pts

// ─── DISPLACEMENT: FVG forming within max_setup_age bars after SFP ──
bars_since_bull_sfp = ta.barssince(bull_sfp)
bars_since_bear_sfp = ta.barssince(bear_sfp)

bull_setup = bull_fvg and not na(bars_since_bull_sfp) and bars_since_bull_sfp <= max_setup_age
bear_setup = bear_fvg and not na(bars_since_bear_sfp) and bars_since_bear_sfp <= max_setup_age

// ta.valuewhen must be called unconditionally every bar (Pine convention)
sfpLowForSL_now  = ta.valuewhen(bull_sfp, low, 0)
sfpHighForSL_now = ta.valuewhen(bear_sfp, high, 0)

// ─── PENDING FVG ZONE + SFP-WICK STOP LEVEL ─────────────────────
var float pendingBullTop = na
var float pendingBullBot = na
var float pendingBearTop = na
var float pendingBearBot = na
var float sfpLowForSL    = na
var float sfpHighForSL   = na
var int   bullZoneBar    = na
var int   bearZoneBar    = na

if bull_setup
    pendingBullTop := low
    pendingBullBot := high[2]
    sfpLowForSL    := sfpLowForSL_now
    bullZoneBar    := bar_index

if bear_setup
    pendingBearTop := low[2]
    pendingBearBot := high
    sfpHighForSL   := sfpHighForSL_now
    bearZoneBar    := bar_index

// expire stale zones
if not na(bullZoneBar) and (bar_index - bullZoneBar) > max_zone_age
    pendingBullTop := na
    pendingBullBot := na
if not na(bearZoneBar) and (bar_index - bearZoneBar) > max_zone_age
    pendingBearTop := na
    pendingBearBot := na

retrace_into_bull_fvg = not na(pendingBullTop) and low <= pendingBullTop and low >= pendingBullBot
retrace_into_bear_fvg = not na(pendingBearTop) and high >= pendingBearBot and high <= pendingBearTop

long_signal  = retrace_into_bull_fvg and bull_bias and trending and strategy.position_size == 0
short_signal = retrace_into_bear_fvg and bear_bias and trending and strategy.position_size == 0

// ─── ENTRY / EXIT ────────────────────────────────────────────────
if long_signal
    long_stop_px = sfpLowForSL - sl_buffer
    long_risk    = close - long_stop_px
    long_tp_px   = close + long_risk * rr_ratio
    strategy.entry("Long", strategy.long, qty=max_contracts, comment="Bull SFP+FVG")
    strategy.exit("Long Exit", stop=long_stop_px, limit=long_tp_px, comment_loss="SL", comment_profit="TP")
    pendingBullTop := na
    pendingBullBot := na

if short_signal
    short_stop_px = sfpHighForSL + sl_buffer
    short_risk    = short_stop_px - close
    short_tp_px   = close - short_risk * rr_ratio
    strategy.entry("Short", strategy.short, qty=max_contracts, comment="Bear SFP+FVG")
    strategy.exit("Short Exit", stop=short_stop_px, limit=short_tp_px, comment_loss="SL", comment_profit="TP")
    pendingBearTop := na
    pendingBearBot := na

// ─── VISUALS ──────────────────────────────────────────────────────
plotshape(bull_setup,   "Bull SFP+FVG formed", shape.circle,       location.belowbar, color.new(color.aqua, 0),     size=size.tiny)
plotshape(bear_setup,   "Bear SFP+FVG formed", shape.circle,       location.abovebar, color.new(color.fuchsia, 0),  size=size.tiny)
plotshape(long_signal,  "Long Entry",          shape.triangleup,   location.belowbar, color.new(color.lime, 0),     size=size.small)
plotshape(short_signal, "Short Entry",         shape.triangledown, location.abovebar, color.new(color.red, 0),      size=size.small)
