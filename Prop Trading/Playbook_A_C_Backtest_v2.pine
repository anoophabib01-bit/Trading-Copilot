//@version=5
strategy("Playbook A+C v2 - 4H Structure + 1H Engulf | Anoop",
     overlay            = true,
     initial_capital    = 50000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 1.0,
     slippage           = 2,
     pyramiding         = 1,
     calc_on_every_tick = false,
     max_bars_back      = 500)

// ============================================================
// PLAYBOOK A + C -- best-effort codification. Read before trusting results:
//  - "4H structure" = confirmed swing pivots (left/right bars below),
//    NOT a literal HH/HL label drawn by eye. Pivot confirmation lag
//    means structure updates a few bars late vs a human reading it live.
//  - "Liquidity already swept" = price closed beyond the last confirmed
//    swing level within the lookback window before this signal. This is
//    a proxy for the discretionary "don't chase, you're late" rule.
//  - "Exit at marker levels" (CLAUDE.md) is NOT coded -- Pine has no
//    concept of your manually drawn chart zones. This exits at an R:R
//    target instead. Read results as "does the entry+SL edge exist,"
//    not "does my exact exit process work."
//  - Run this on the 1H chart (MNQ1!). It pulls 4H structure via
//    request.security.
//  - Compiled clean on TradingView (v5, only a "v6 recommended" notice,
//    no blocking errors) as of 2026-07-04.
// ============================================================

var GRP1 = "Structure (4H)"
piv_left       = input.int(3, "Pivot Left Bars (4H)", minval=1, maxval=10, group=GRP1)
piv_right      = input.int(3, "Pivot Right Bars (4H)", minval=1, maxval=10, group=GRP1)
sweep_lookback = input.int(20, "Liquidity-swept lookback (1H bars)", minval=5, maxval=100, group=GRP1,
     tooltip="How far back to treat the relevant swing level as 'already swept, too late'")

var GRP2 = "Engulfing (1H)"
body_pct = input.float(0.3, "Min engulf body (% of 1H ATR14)", minval=0.1, maxval=2.0, step=0.1, group=GRP2)

var GRP3 = "Risk / Exit"
rr_ratio      = input.float(2.0, "Target R:R (proxy for 'marker level' exit)", minval=1.0, maxval=5.0, step=0.5, group=GRP3)
stop_buf      = input.float(3.0, "Stop buffer beyond engulf bar (pts)", minval=0.0, maxval=20.0, step=0.5, group=GRP3)
max_contracts = input.int(1, "Contracts (MNQ micros)", minval=1, maxval=40, group=GRP3)

// ─── 4H SWING STRUCTURE (via request.security) ──────────────
f_swingStructure(leftB, rightB) =>
    var float sh1 = na
    var float sh2 = na
    var float sl1 = na
    var float sl2 = na
    ph = ta.pivothigh(leftB, rightB)
    pl = ta.pivotlow(leftB, rightB)
    if not na(ph)
        sh2 := sh1
        sh1 := ph
    if not na(pl)
        sl2 := sl1
        sl1 := pl
    bull4h = not na(sh2) and not na(sl2) and sh1 > sh2 and sl1 > sl2
    bear4h = not na(sh2) and not na(sl2) and sh1 < sh2 and sl1 < sl2
    [bull4h, bear4h, sh1, sl1]

[bull4h, bear4h, swingHigh4h, swingLow4h] = request.security(syminfo.tickerid, "240", f_swingStructure(piv_left, piv_right), lookahead=barmerge.lookahead_off)

// ─── 1H ENGULFING CANDLE ─────────────────────────────────────
atr14     = ta.atr(14)
min_body  = atr14 * body_pct
prev_bull = close[1] > open[1]
prev_bear = close[1] < open[1]
curr_body = math.abs(close - open)

bull_engulf_1h = close > open and prev_bear and open <= close[1] and close >= open[1] and curr_body >= min_body
bear_engulf_1h = close < open and prev_bull and open >= close[1] and close <= open[1] and curr_body >= min_body

// ─── LIQUIDITY-SWEPT EXCLUSION (Playbook C) ─────────────────
crossed_above_swingHigh = ta.crossover(close, swingHigh4h)
bars_since_cross_above  = ta.barssince(crossed_above_swingHigh)
buy_side_already_swept  = not na(bars_since_cross_above) and bars_since_cross_above >= 1 and bars_since_cross_above < sweep_lookback

crossed_below_swingLow  = ta.crossunder(close, swingLow4h)
bars_since_cross_below  = ta.barssince(crossed_below_swingLow)
sell_side_already_swept = not na(bars_since_cross_below) and bars_since_cross_below >= 1 and bars_since_cross_below < sweep_lookback

// ─── FULL PLAYBOOK A+C SIGNAL ────────────────────────────────
long_signal  = bull4h and bull_engulf_1h and not buy_side_already_swept  and strategy.position_size == 0
short_signal = bear4h and bear_engulf_1h and not sell_side_already_swept and strategy.position_size == 0

// second entry once first is in profit, per Playbook A ("Entry 2 + move SL to BE")
add_long  = strategy.position_size == max_contracts  and close > strategy.position_avg_price and bull4h and bull_engulf_1h
add_short = strategy.position_size == -max_contracts and close < strategy.position_avg_price and bear4h and bear_engulf_1h

// ─── STOP / TARGET (set at entry, held via var) ──────────────
var float active_long_stop  = na
var float active_long_tp    = na
var float active_short_stop = na
var float active_short_tp   = na

if long_signal
    long_stop_px = low - stop_buf
    long_risk    = close - long_stop_px
    strategy.entry("Long", strategy.long, qty=max_contracts, comment="Bull A+C")
    active_long_stop := long_stop_px
    active_long_tp   := close + long_risk * rr_ratio

if add_long
    strategy.entry("Long2", strategy.long, qty=max_contracts, comment="Add + BE")
    active_long_stop := strategy.position_avg_price

if short_signal
    short_stop_px = high + stop_buf
    short_risk    = short_stop_px - close
    strategy.entry("Short", strategy.short, qty=max_contracts, comment="Bear A+C")
    active_short_stop := short_stop_px
    active_short_tp   := close - short_risk * rr_ratio

if add_short
    strategy.entry("Short2", strategy.short, qty=max_contracts, comment="Add + BE")
    active_short_stop := strategy.position_avg_price

if strategy.position_size == 0
    active_long_stop  := na
    active_long_tp    := na
    active_short_stop := na
    active_short_tp   := na

if strategy.position_size > 0
    strategy.exit("Long Exit", stop=active_long_stop, limit=active_long_tp, comment_loss="SL/BE", comment_profit="TP")
if strategy.position_size < 0
    strategy.exit("Short Exit", stop=active_short_stop, limit=active_short_tp, comment_loss="SL/BE", comment_profit="TP")

// ─── VISUALS ──────────────────────────────────────────────────
plotshape(long_signal,  "Long Signal",  shape.triangleup,   location.belowbar, color.new(color.lime, 0),   size=size.small)
plotshape(short_signal, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0),    size=size.small)
plot(swingHigh4h, "4H Swing High", color.new(color.orange, 40))
plot(swingLow4h,  "4H Swing Low",  color.new(color.blue, 40))
